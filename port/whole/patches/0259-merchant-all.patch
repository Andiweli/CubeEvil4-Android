@@ -1611,6 +1750,7 @@ void Merchant::save(MERCHANT_DATA* p_data)
 {
     p_data->stock = m_stock;
     p_data->level = level;
+    re4MerchantKeepOwn(p_data, &m_stock, &level); /* port (patch 0259): the merchant's own tables, never the offer */
     p_data->friendship = m_friendship;
     p_data->study_num = m_study_num;
     p_data->reduction_ratio = m_reduction_ratio;
@@ -2132,7 +2272,8 @@ int Merchant::buyupPrice(cItem* item, int num)
         }
     }
     if (itemType(item->id) == 1 && num == 1) {
-        if (!re4_disc_retail() || item->id != 0x37) {
+        /* port (patch 0259): with "All weapons at the merchant" the handcannon without its ammo (no money loop) */
+        if ((!re4_disc_retail() || item->id != 0x37) && !(item->id == 0x37 && (re4MerchantOn & 1))) {
             price += buyupPrice(WeaponId2BulletId(item->id, item->getBulletType()), item->bullet & 0x1FFF);
         }
         for (type = 0; type <= 3; type++) {
