+        /* port (patch 0161): the time's own sounds, as the European sceAtGetItem (0x40 time, 0 bonus time) */
+        SndCall(0, it->item_id == 0x73 ? 0x40 : it->item_id == 0x75 ? 0 : 0x10, 0, 0, 0, 0);
         break;
     }
