+/* PORT (patch 0227): Render_done for a picture left out (the app menu's "Aggressive frame skip"): no copy and
+   no wait for the GPU, but the scenario's C task gets its time slices as in Render_done */
+void Render_done_skip()
+{
+    if (SceSys.checkCTaskRange() != 0) {
+        SceSys.setDrawDone(1);
+        SceSleep(1);
+    }
+    if (SceSys.checkCTaskRange() != 0) {
+        SceSys.setDrawDone(1);
+        SceSleep(1);
+    }
+}
