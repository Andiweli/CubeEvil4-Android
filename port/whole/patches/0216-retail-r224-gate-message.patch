     SndCall(6, 6, &SmdGetObjPtr(0x12)->pos, 0, 0, 0);
     SceAtDataReset(0);
+    /* port (patch 0216): the gate is open, its message off (European, Japanese and Korean code) */
+    if (r224_gate_mes_area()) {
+        SceAtSetEnable(10, 0);
+    }
     SceAtSetEnable(8, 0);
     SceEventStart(1);
     CamCtrl.CutCall(6);
