 typedef struct tagESP19_WK {
@@ -482,6 +484,7 @@
         esp->m_Logic_op = 0;
         esp->m_Col_a *= 0.8f;
     }
+    re4_laser_tint(esp, 0); /* PORT (patch 0198) */
 }
 
