 // then plays the talking motions and shows the frame units; fires every OpeMesSeq entry whose time
 // has come (OpeSeqMove). B (Key bit 18) skips: the stream stops and A/B step the remaining entries
 // by hand. Returns 1 when the sequence ended (arg == -1 entry).
+/* port: the European radio screen (ss/<lang>/ss_term.dat sub-file 9) has three more picture groups,
+   units 0x15, 0x16 and 0x17 (partner pictures of calls 14 and 15), and the European Sscrn.rel switches
+   them, and 0x12, at a frame of the call: call 13 shows 0x12 at frame 600, call 14 swaps 0x16 for
+   0x15 at frame 5, call 15 shows 0x17 at frame 1215, call 17 shows 0x12 at frame 444 (the table of
+   the European data section 20 +0x1200, OpeMesMove after seqCnt++). */
+extern "C" int re4_disc_retail_eu(void); /* port: runtime/dvd.cpp */
+
+static void termRetailShow(u8 mark)
+{
+    ID_UNIT* u = IdSub.unitPtr(mark, IDC_SSCRN_NEAR_0);
+    u->be_flag |= 8;
+    u->rev_flag &= 0xF0;
+    IdSub.setTime(u, 0);
+}
+
+static void termRetailPictures(int frame)
+{
+    switch (SubScreenWk.opeMdtNo) {
+    case 13:
+        if (frame == 600) {
+            termRetailShow(0x12);
+        }
+        break;
+    case 14:
+        if (frame == 5) {
+            IdSub.unitPtr(0x16, IDC_SSCRN_NEAR_0)->be_flag &= ~8;
+            termRetailShow(0x15);
+        }
+        break;
+    case 15:
+        if (frame == 1215) {
+            termRetailShow(0x17);
+        }
+        break;
+    case 17:
+        if (frame == 444) {
+            termRetailShow(0x12);
+        }
+        break;
+    }
+}
