# Retail data (port/docs/retail-eu-plan.md, R7): MessageControl::setLayout picks the font size, char
# spacing and line gap of a message slot from a table with two rows, Japanese and English, by the
# message language; German, French, Spanish and Italian (2..5) read past it and drew the radio
# subtitles with huge, smeared letters (French run, 26.10.2026). The European setLayout (main.dol
# 0x80023610, table 0x801F8E04, also two rows) takes the Japanese row for pSys->language 0 and the
# English row for every other language; so does this one. With the debug build's discs (language 1)
# nothing changes. A bug of the prototype as well: its debug menu offers languages 2..7.
--- a/src/game/mes.cpp
+++ b/src/game/mes.cpp
@@ -307,7 +307,10 @@
     };
     static s8* p_layout;
 
-    p_layout = layout_tbl[MesData.getLanguage()][type];
+    /* port: the table has the Japanese and the English layout only; the message languages 2..5
+       (German, French, Spanish, Italian) read past it. The European setLayout (main.dol
+       0x80023610) takes the English layout for every language but Japanese. */
+    p_layout = layout_tbl[pSys->language == 0 ? 0 : 1][type];
     setFontSize(no, p_layout[0], p_layout[1]);
     setFontGap(no, p_layout[3]);
     setLineGap(no, p_layout[5]);
