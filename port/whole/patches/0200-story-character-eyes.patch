         p[1] = pPL->getPartsPtr(0x21);
         PSVECAdd(&p[0]->world, &p[1]->world, &pos_ofs);
         PSVECScale(&pos_ofs, &pos_ofs, 0.5f);
+        /* PORT (patch 0200): HUNK standing in for Leon has no eyes there: the point of Leon's */
+        re4_story_char_eyes(&pos_ofs);
         cPlayer* pl = pPL;
 
         d = &m_rad;
@@ -551,6 +554,8 @@
         p[1] = pPL->getPartsPtr(0x21);
