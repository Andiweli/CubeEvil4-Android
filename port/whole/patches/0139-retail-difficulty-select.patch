# Retail data (port/docs/retail-eu-plan.md): the difficulty choice of the European title. The debug build's
# "new game" starts on Normal at once and asks for the difficulty only once professional is unlocked. The
# European titleMain (main.dol 0x80165d58, titleMenuSelect 0x8016510c, their level menu 0x80165370 /
# 0x80165570, read with retail_code.py) always asks: Professional (only once unlocked, EXT_HARD_MODE; units 1
# and 2 hidden otherwise), Normal (cursor start) and Easy, A or START chooses (game_mode 6 / 5 / 3), the cursor
# wraps around and skips the hidden entry, B goes back to "new game" with the cancel sound. Their question
# after the choice (core messages 0xA8..0xAA with yes / no) is asked with Japanese texts only (the European
# languages hold "aaa" there), so it is left out. Not with the debug start of the checks (RE4_START_ROOM;
# RE4_TEST_GAME_MODE sets the difficulty there). Nothing changes with the debug build's discs. A port patch
# for retail data.
--- a/src/game/title.cpp
+++ b/src/game/title.cpp
@@ -518,12 +518,76 @@
     } else {
         w->menu_num = 3;
     }
+    /* port: with the European discs professional (entry 0, units 1 and 2) shows only once it is
+       unlocked, as their code (patch 0139) */
+    if (re4_disc_retail_eu() && pSys->language != 1 && !ExtFlagChk(pSys, EXT_HARD_MODE)) {
+        IdSys.unitPtr(1, IDC_TITLE_MENU)->be_flag &= ~8;
+        IdSys.unitPtr(2, IDC_TITLE_MENU)->be_flag &= ~8;
+    }
     w->cursor = 1;
+}
+
+/* port: the European difficulty menu (patch 0139): A or START chooses (0 professional, 1 normal,
+   2 easy), the cursor wraps around and skips professional while it is hidden */
+static int titleLevelSelectRetail(TITLE_WORK* w)
+{
+    int first = ExtFlagChk(pSys, EXT_HARD_MODE) ? 0 : 1;
+    int old = w->cursor;
+    int i;
+
+    if (Key.trg & (KEY_A | KEY_START)) {
+        switch (w->cursor) {
+        case 0:
+            pG->game_mode = 6;
+            break;
+        case 2:
+            pG->game_mode = 3;
+            break;
+        default:
+            pG->game_mode = 5;
+            break;
+        }
+        return 1;
+    }
+    if (Key.trg & KEY_UP) {
+        w->cursor--;
+    }
+    if (Key.trg & KEY_DOWN) {
+        w->cursor++;
+    }
+    if (w->cursor < first) {
+        w->cursor = w->menu_num - 1;
+    } else if (w->cursor > w->menu_num - 1) {
+        w->cursor = first;
+    }
+    if (old != w->cursor) {
+        SndCall(0, 10, 0, 0, 0, 0);
+    }
+    for (i = 0; i < w->menu_num; i++) {
+        if (i == w->cursor) {
+            w->p_menu[i]->be_flag |= 8;
+        } else {
+            w->p_menu[i]->be_flag &= ~8;
+        }
+    }
+    if (w->menu_num > 1 && (Key.trg & (KEY_UP | KEY_DOWN))) {
+        for (i = 0; i < w->menu_num; i++) {
+            ID_UNIT* u = w->p_menu[i];
+            u->timer[3] = 0;
+            u->timer[1] = 0;
+            u->timer[2] = 0;
+            u->timer[0] = 0;
+        }
+    }
+    return 0;
 }
 
