# Port patch, a new cheat (wish of the project owner, 05.11.2026; the app menu's CHEATS page, PLAYER & INVENTORY,
# "Invisibility", off by default): the enemies take no notice of the player. emMove (em.cpp) gives every enemy (cEm
# id 0x10..0x3F: the Ganados, the animals, the giants, the bosses; not Ashley, Luis, the boats or the objects such
# as doors and boxes, which open by the distance too) the player's distance as 1e16 (what em_set.cpp gives the
# partner's before it is known), so whatever asks the distance does not see, approach or attack him. The Ganados
# (em10) also find him by sight, his steps, his shots, the bell, a hit or a neighbour's alert: em10FindCk finds
# nothing, setFindPL tells them nothing, and one that had found him forgets him (clearFindPL) in its next frame.
# runtime/cheats.cpp re4_invisible (bit 512 of the app's cheat switches) also sets DBG_EM_NO_ATK, the debug bit
# that holds the Ganados' attacks. Off: as the game.
--- a/src/game/em.cpp
+++ b/src/game/em.cpp
@@ -30,6 +30,7 @@
 #include "em_sub.h"
 #include "read.h"
 #include "shape.h"
+extern "C" int re4_invisible(void); /* port (patch 0204): runtime/cheats.cpp, the cheat "Invisibility" */
 
 
 // cManager<T>::arrayFree / arrayAlloc: definitions in cManager.h (game.cpp instantiates them too).
@@ -369,6 +370,12 @@
     dz = pPL->pos.z - pEm->pos.z;
     dx = pPL->pos.x - pEm->pos.x;
     pEm->l_pl = dx * dx + dz * dz;
+    /* port (patch 0204): "Invisibility": to the enemies (ids 0x10..0x3F; not Ashley, Luis, the boats, the
+       objects) the player is as far away as the partner is before it is set (em_set.cpp), so nothing that
+       asks the distance finds, approaches or attacks him */
+    if (pEm->id >= 0x10 && pEm->id < 0x40 && re4_invisible()) {
+        pEm->l_pl = 1e16f;
+    }
     pEm->l_sub = 1e16f;
     pEm->dmg.move();
     pEm->move();
