# Port patch for retail data (tester report 31.10.2026, EU discs: in r403 nearly every Ganado ran at the player at
# once). The retail discs have a rebuilt Mercenaries enemy list (etc/omake02.esl, the same on the US, EU and JP discs;
# r403 nearly every entry, r404 70 of 84) for the prototype's room code, whose start sets and reset groups the retail
# st4_0.rel keeps (r400, r403, r404 read with retail_code.py on 31.10.2026). What the retail rooms changed:
# - r403 em_reset and r404_setEm set no enemy while the player is on a ladder (PlGetStatus() & 0x40000): US, EU, JP.
# - r400 / r403 em_reset and r404_setEm send the re-set Ganados with goto mode 15 (patch 0165) instead of 0xC: they
#   stop 3 m before where the player was instead of attacking on arrival: EU and JP (the US release keeps 0xC).
# - R403Main refills zones 0 and 0x10 too: their check timer > 1800 never held (the timer counts 1..300); EU and JP
#   dropped it, the US release keeps it.
# r402 differs more (its own enemy set code, R402EmSetMain) and is not covered here. Debug discs unchanged.
--- a/src/st4/r400.cpp
+++ b/src/st4/r400.cpp
@@ -480,6 +480,10 @@
 }
 
 // Resets list entry `no` (chk: only while fewer than 10 enemies are alive); 1 when it was set.
+extern "C" int re4_disc_retail(void);     /* port: runtime/dvd.cpp (patch 0166) */
+extern "C" int re4_disc_retail_eu(void);
+extern "C" int re4_disc_retail_jp(void);
+u32 PlGetStatus();
 int em_reset(int no, int chk)
 {
     if (chk == 1 && r400_work->cnt > 9) {
@@ -490,7 +494,8 @@
     }
     cEmWrap em;
     em.setEm(no, -1, 1, 1, 1);
-    em.setGoto(&pPL->pos, 0xC);
+    /* port (patch 0166): the European / Japanese release send them with goto mode 15 */
+    em.setGoto(&pPL->pos, re4_disc_retail_eu() || re4_disc_retail_jp() ? 0xF : 0xC);
     r400_work->base++;
     r400_work->cnt++;
     SceDebugDisp("RESET[%d]", no);
--- a/src/st4/r403.cpp
+++ b/src/st4/r403.cpp
