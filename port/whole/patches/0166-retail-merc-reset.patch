     if (pG->Em_list[no].be_flag & 2) {
         return 0;
     }
+    /* port (patch 0166): the retail releases set none while the player is on a ladder (PlGetStatus 0x40000) */
+    if (re4_disc_retail() && (PlGetStatus() & 0x40000)) {
+        return 0;
+    }
     cEmWrap em;
     em.setEm(no, -1, 1, 1, 1);
-    em.setGoto(&pPL->pos, 0xC);
+    /* port (patch 0166): the European / Japanese release send them with goto mode 15 */
+    em.setGoto(&pPL->pos, re4_disc_retail_eu() || re4_disc_retail_jp() ? 0xF : 0xC);
     r403_work->base++;
     r403_work->cnt++;
     SceDebugDisp("RESET[%d]", no);
@@ -545,7 +554,9 @@
         }
         r403_work->cnt = SceCountEmAlive(0x10, 0x20);
         SceDebugDisp("EM_NUM[%d/%d]", r403_work->cnt, r403_work->base);
-        if (r403_work->timer > 1800) {
+        /* port (patch 0166): timer counts 1..300 only, so zones 0 and 0x10 never refilled; the European /
+           Japanese release dropped the check */
+        if (r403_work->timer > 1800 || re4_disc_retail_eu() || re4_disc_retail_jp()) {
             if (pG->Room_flg[2] & 0x80000000) {
                 reset_40();
             }
