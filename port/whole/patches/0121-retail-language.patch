# Retail data (port/docs/retail-eu-plan.md, R7): the language with the European discs. The European
# setLanguage takes the console's system language (2 English .. 6 Italian), this build fixes 1 (the US
# release: no event subtitles, two difficulties). Decisions of the project owner (26.10.2026): the app's
# in-game menu chooses it (the phone's language until then), a change applies at once, the title menu's
# "LANGUAGE SELECT" (European title.dat, units 11 and 12) goes. setLanguage, systemWorkInit (every start
# and soft reset, before the title reads its language's data) and the system file's load (card.cpp)
# take the app's language, the title and play ask every frame (runtime/game_language.cpp). The
# European German, French, Spanish and Italian SS/<lang>/option.dat are larger than the fixed place of
# OptionDataRead (0x44000 to 0x4C2C0 of 0x40000 bytes: they ran into the player data, the game ended
# at the start of r120): a larger one is read to another place (runtime/dvd.cpp re4_option_data_place).
# Nothing changes with the debug build's discs. A port patch for retail data.
--- a/src/game/main.cpp
+++ b/src/game/main.cpp
@@ -427,6 +427,8 @@
 
 // Default global state: debug mode, start room r120 (Part 0), Leon, game mode 5, costumes 0,
 // user name buffer and language 1.
+extern "C" int re4_game_language_value(void); /* port: runtime/game_language.cpp */
+
 void systemWorkInit()
 {
     systemScreenInit();
@@ -443,6 +445,11 @@
     pSys->language = 1;
     pSys->eff_country = 1;
     pG->game_country = 1;
+    /* port: with the European discs the app's language (setLanguage below), before the title
+       reads its language's data */
+    if (re4_game_language_value() >= 0) {
+        setLanguage();
+    }
 }
 
 // Frames per game update in vsyncs (1 = 60 Hz, 2 = 30 Hz).
@@ -583,6 +590,11 @@
 void setLanguage()
 {
     pSys->language = 1;
+    /* port: with the European discs the language the European setLanguage takes from the console
+       (2 English .. 6 Italian): here the app's choice */
+    if (re4_game_language_value() >= 0) {
+        pSys->language = (u8) re4_game_language_value();
+    }
     pSys->eff_country = pSys->language;
     pG->game_country = pSys->language;
 }
