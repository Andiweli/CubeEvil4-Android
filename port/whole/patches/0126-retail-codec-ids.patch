# Retail data (port/docs/retail-eu-plan.md, R3): the radio screen's subtitle bar with the European discs.
# SubScreenExec gives the radio screen (open_flag 0x20) an IdSub of 128 units and sets four shared id
# tables of ss_cmmn.dat (pesetas, main menu, etc., background), the main menu hidden at once. The
# European tables are larger: they filled all 128 units and the radio's own ones, the dark bar behind
# the subtitle among them, found no room ("IDSystem::set() work full", PC runs 27.10.2026: IdSub 128 of
# 128, 46 of them main menu, 31 missing). With the European discs the radio screen leaves the main menu
# out. Tried first and dropped: all four tables out as the European SubScreenExec (main.dol 0x8005a920)
# does, and 512 units for the radio screen; both lost Hunnigan's picture (the larger IdSub overlaid
# ss_oc101.dat). Nothing changes with the debug build's discs. A port patch for retail data.
--- a/src/game/sscrn.cpp
+++ b/src/game/sscrn.cpp
@@ -313,6 +313,8 @@
 // heap swapped to ARAM and the sub screen data swapped in (MemorySwap), fonts and shared id data
 // set up for the screen type, the Sscrn REL linked, then TaskChain into its prolog (the DLL runs
 // the screen and calls SubScreenExit when done).
+extern "C" int re4_disc_retail_eu(void); /* port: runtime/dvd.cpp */
+
 void SubScreenExec()
 {
     SubScreenWork* wk = &SubScreenWk;
@@ -472,7 +474,9 @@
                 IdNum.gameInit(0x1B2);
             }
             IdSub.set((ID_FILE_HEADER*) SS_ARC_PTR(wk->pCmmn, 7), 0xFF, IDC_SSCRN_PESETA, 0x13, 7, 0);
-            if (!(wk->open_flag & 0x10)) {
+            /* port: the radio screen (0x20) hides the main menu at once; with the European discs its
+               larger table filled the radio screen's 128 units and the subtitle bar found no room */
+            if (!(wk->open_flag & 0x10) && !(wk->open_flag == 0x20 && re4_disc_retail_eu())) {
                 IdSub.set((ID_FILE_HEADER*) SS_ARC_PTR(wk->pCmmn, 0xB), 0xFF, IDC_SSCRN_MAIN_MENU, 0xF, 0, 0);
             }
             IdSub.set((ID_FILE_HEADER*) SS_ARC_PTR(wk->pCmmn, 0x11), 0xFF, IDC_SSCRN_ETC, 0x13, 9, 0);
