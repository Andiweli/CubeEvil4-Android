+        f32 fogEnd = fog->End;
+        f32 farPlane = fog->End * (1.0f - LightEnv.far_play_ratio) + 1.0f;
+        re4_view_fog(fog->Type, LightEnv.far_play_ratio, &fogStart, &fogEnd, &farPlane);
+        GXSetFog(fog->Type, fogStart, fogEnd, ZNEAR, ZFAR, fog->Color);
         if (fog->Type == 0) {
             View.setFarPlane(ZFAR);
