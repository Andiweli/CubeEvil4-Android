         GXSetFog(0, 0.0f, 0.0f, ZNEAR, ZFAR, black);
     } else {
-        GXSetFog(fog->Type, fog->Start, fog->End, ZNEAR, ZFAR, fog->Color);
+        /* port (patch 0223): the app menu's view distance, the fog the GPU gets and the far plane */
