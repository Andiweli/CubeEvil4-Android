+        f32 fogEnd = fog->End;
+        re4_view_distance(fog->Type, &fogStart, &fogEnd);
+        GXSetFog(fog->Type, fogStart, fogEnd, ZNEAR, ZFAR, fog->Color);
         if (fog->Type == 0) {
             View.setFarPlane(ZFAR);
         } else {
-            View.setFarPlane(fog->End * (1.0f - LightEnv.far_play_ratio) + 1.0f);
