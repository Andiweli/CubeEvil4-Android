# Port patch (1.1.0; the idea from a user's "ModernTPS" mod, our own code): the mouse in the title menu, the
# difficulty menu (the European one of patch 0139 too) and the options' top menu. Before each reads Key, the entry
# under the app's mouse pointer (runtime/mouse_menu.cpp) becomes the cross's up or down of this frame until the
# game's own cursor is there, and a left click on it is A; so the game's sound, wrap-around and skipped entries stay.
# Without a mouse (or when it did not move or click) it returns 0: as the game.
--- a/src/game/title.cpp
+++ b/src/game/title.cpp
@@ -76,6 +76,7 @@
 int titleMenuSelect(TITLE_WORK* w);
 void titleLevelInit(TITLE_WORK* w);
 int titleLevelSelect(TITLE_WORK* w);
+extern "C" unsigned long long re4_mouse_menu_keys(ID_UNIT** units, int n, int first, int cursor); /* patch 0239 */
 void titleLoop(TITLE_WORK* w);
 void id_color_copy(int src, int dst, u8 type);
 void stageSelectInit(TITLE_WORK* w);
@@ -465,6 +466,9 @@
 {
     int ret = 0;
 
+    /* port (patch 0239): the mouse's pointer and click (runtime/mouse_menu.cpp) */
+    Key.trg |= re4_mouse_menu_keys(w->p_menu, w->menu_num, 0, w->cursor);
+
     if (Key.trg & KEY_A) {
         if (ExtFlagChk(pSys, EXT_HARD_MODE)) {
             switch (w->cursor) {
@@ -585,6 +589,9 @@
 // A on the difficulty menu sets pG->Game_level (by cursor and language); returns 1 when chosen.
 int titleLevelSelect(TITLE_WORK* w)
 {
+    /* port (patch 0239): the mouse; the European menu hides Professional (entry 0) until it is unlocked */
+    Key.trg |= re4_mouse_menu_keys(w->p_menu, w->menu_num,
+                                   re4_disc_retail_eu() && !ExtFlagChk(pSys, EXT_HARD_MODE) ? 1 : 0, w->cursor);
     if (re4_disc_retail_eu()) {  /* port: the European menu (patch 0139) */
         return titleLevelSelectRetail(w);
     }
--- a/src/game/option.cpp
+++ b/src/game/option.cpp
@@ -25,6 +25,7 @@
 #define KEY_START 0x2000
 
 int top_menu(OptionScreen* o);
+extern "C" unsigned long long re4_mouse_menu_keys(ID_UNIT** units, int n, int first, int cursor); /* patch 0239 */
 void back_to_top_menu(OptionScreen* o);
 int retry_load_menu(OptionScreen* o);
 int controller_menu(OptionScreen* o);
@@ -192,6 +193,14 @@
     ID_UNIT* u;
     int i;
 
+    /* port (patch 0239): the mouse's pointer and click (runtime/mouse_menu.cpp); on the title the first row is out */
+    {
+        ID_UNIT* rows[5];
+        for (i = 0; i < 5; i++) {
+            rows[i] = IdSys.unitPtr((u8) (i + 2), IDC_OPTION);
+        }
+        Key.trg |= re4_mouse_menu_keys(rows, 5, StaFlagChk(pG, STA_TITLE) ? 1 : 0, pOpt->_rno1);
+    }
     if (Key.trg & KEY_START) {
         return 1;
     }
