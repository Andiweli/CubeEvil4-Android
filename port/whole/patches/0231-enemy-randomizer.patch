# Port patch, decision of the project owner (12.11.2026: "Ok den Randomizer Schalter wie von dir vorgeschlagen 'Stufe 1'
# und als Button neben dem Item Randomizer"; port/docs/gegner-randomizer-plan.md): the cheat "Random enemies" of the
# app's cheat menu. EmSetFromList creates the room's entries of the chapter's enemy list when a room starts; with the
# cheat on, runtime/enemy_random.cpp plans the room first (re4_enemy_random_room), then gives each entry that passed
# the game's checks either as it is, left out, or as a copy with the spot of another entry of the room (only ordinary
# Ganados, never entries the room's script or areas name, never in rooms whose script counts or sweeps enemies or has
# a boss), and at the end at most one more enemy: a copy of an ordinary Ganado whose kind is in the room, its death
# kept at an empty entry of the list. The list itself (saved with the game) is never written. With the cheat off
# nothing changes.
--- a/src/game/em_set.cpp
+++ b/src/game/em_set.cpp
@@ -13,6 +13,12 @@
 cEm* errEm = 0;
 static int emSetDummy = 0;
 
+/* port (patch 0231): the cheat "Random enemies" (runtime/enemy_random.cpp) */
+extern "C" void re4_enemy_random_room(void);
+extern "C" int re4_enemy_random_entry(int no, EM_LIST* out);
+extern "C" int re4_enemy_random_extra(EM_LIST* out);
+extern "C" void re4_enemy_random_extra_made(int ok);
+
 // Death bit of list entry `no` in the current enemy list (0 when no list is loaded).
 // Death bit of list entry `no` in the current list (pG->em_list_no); 0 when no list is loaded.
 static inline u32 EmSetDieCk(u32 no)
@@ -138,9 +144,13 @@
 {
     u32 i;
 
+    /* port (patch 0231): the cheat "Random enemies" plans the room's start */
+    re4_enemy_random_room();
     for (i = 0; i < 256; i++) {
         EM_LIST* d = &pG->Em_list[i];
         cEm* em;
+        EM_LIST moved;  /* port (patch 0231) */
+        int how;
 
         if (!(d->be_flag & 1)) {
             continue;
@@ -168,12 +178,18 @@
         if (EM_SET_ID_NG(d->id)) {
             continue;
         }
+        /* port (patch 0231): left out (-1), as it is (0), or from a copy of the entry with another spot (1); the
+           list itself stays as it is */
+        how = re4_enemy_random_entry((int) i, &moved);
+        if (how < 0) {
+            continue;
+        }
         em = EmCreate(d->id);
         if (em == 0) {
             pLog->err(0, 0, "EmSetFromList() Em set failed, Id = %x", d->id);
             continue;
         }
-        EmSetWork(em, d, i);
+        EmSetWork(em, how > 0 ? &moved : d, i);
         d->be_flag |= 2;
         if (d->be_flag & 4) {
             d->be_flag |= 8;
@@ -185,6 +201,27 @@
         em->l_sub = 1.0e16f;
         em->move();
     }
+    /* port (patch 0231): one more enemy, a copy at a spot nobody took; its death is kept at an empty entry of the
+       list (id 0, never used by the game) */
+    {
+        EM_LIST extra;
+        int no = re4_enemy_random_extra(&extra);
+
+        if (no >= 0) {
+            cEm* em = 0;
+
+            if (!EmSetDieCk((u32) no) && checkListId(no)) {
+                em = EmCreate(extra.id);
+            }
+            re4_enemy_random_extra_made(em != 0);
+            if (em != 0) {
+                EmSetWork(em, &extra, (u8) no);
+                EmSetDist(em);
+                em->l_sub = 1.0e16f;
+                em->move();
+            }
+        }
+    }
 }
 
