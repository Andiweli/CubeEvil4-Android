+// stockDataAdd of the retail discs. mode 0: a room's table, in a cleared game (game_cnt) only a first aid spray;
+// 1: a table of the cleared game; 2: an unlocked weapon (the "new" marks stay). The European one leaves the
+// bulletproof vest 0xFE out on Professional.
+static void stockDataAddRetail(MERCHANT_DATA* d, StockEntry* tbl, int mode)
+{
+    StockEntry* s;
+    int i;
+
+    if (mode == 0 && pG->game_cnt != 0) {
+        tbl = stock_firstaid_retail;
+    }
+    if (mode != 2) {
+        for (s = d->stock.e, i = 0; i < STOCK_MAX && s->id != 0xFFFF; i++, s++) {
+            s->isNew = 0;
+        }
+    }
+    for (; tbl->id != 0xFFFF; tbl++) {
+        int found = 0;
+
+        for (s = d->stock.e, i = 0; i < STOCK_MAX && s->id != 0xFFFF; i++, s++) {
+            if (s->id == tbl->id) {
+                add_stock_retail(s, tbl->num);
+                found = 1;
+                break;
+            }
+        }
+        if (merchantEu() && pG->game_mode > 5 && tbl->id == 0xFE) {
+            found = 1;
+        }
+        if (!found) {
+            for (s = d->stock.e, i = 0; i < STOCK_MAX; i++, s++) {
+                if (s->id == 0xFFFF) {
+                    s->id = tbl->id;
+                    add_stock_retail(s, tbl->num);
+                    s->isNew = 1;
+                    break;
+                }
+            }
+        }
+    }
+}
