+// The price and tune tables of the inserted discs: the retail ones, else the debug build's (kept at the first call).
+static void merchantReleaseData()
+{
+    static PRICE_INFO dbg_price[sizeof(g_item_price_tbl) / sizeof(g_item_price_tbl[0])];
+    static LEVEL_PRICE dbg_level[sizeof(level_price) / sizeof(level_price[0])];
+    static int saved;
+    const PRICE_INFO* src = g_item_price_tbl_us;
+    u32 i;
+
+    if (!saved) {
+        for (i = 0; i < sizeof(dbg_price) / sizeof(dbg_price[0]); i++) {
+            dbg_price[i] = g_item_price_tbl[i];
+        }
+        for (i = 0; i < sizeof(dbg_level) / sizeof(dbg_level[0]); i++) {
+            dbg_level[i] = level_price[i];
+        }
+        saved = 1;
+    }
+    if (!re4_disc_retail()) {
+        src = dbg_price;
+    } else if (merchantEu()) {
+        src = g_item_price_tbl_eu;
+    }
+    for (i = 0; i < sizeof(dbg_price) / sizeof(dbg_price[0]); i++) {
+        g_item_price_tbl[i] = src[i];
+    }
+    for (i = 0; i < sizeof(dbg_level) / sizeof(dbg_level[0]); i++) {
+        LEVEL_PRICE* l = &level_price[i];
+        int k;
+
+        *l = dbg_level[i];
+        if (!re4_disc_retail()) {
+            continue;
+        }
+        if (l->id == 0x23) {
+            *l = level_price_retail_23;
+        } else if (l->id == 0x2A) {
+            for (k = 0; k < 7; k++) {
+                l->power[k] = level_price_retail_2a[k];
+            }
+        } else if (l->id == 0x2C && merchantEu()) {
+            for (k = 0; k < 7; k++) {
+                l->power[k] = level_price_eu_2c[k];
+            }
+        }
+    }
+}
