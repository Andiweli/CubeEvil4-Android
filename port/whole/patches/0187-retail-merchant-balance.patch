+// levelDataAdd of the retail discs: the modes as stockDataAddRetail; a room's table adds nothing in a cleared game.
+static void levelDataAddRetail(MERCHANT_DATA* d, LevelEntry* tbl, int mode)
+{
+    LevelEntry* l;
+    int i;
+    int j;
+
+    if (mode == 0 && pG->game_cnt != 0) {
+        return;
+    }
+    if (mode != 2) {
+        for (l = d->level.e, i = 0; i < LEVEL_MAX && l->id != 0xFFFF; i++, l++) {
+            l->isNew = 0;
+        }
+    }
+    for (; tbl->id != 0xFFFF; tbl++) {
+        int found = 0;
+
+        for (l = d->level.e, i = 0; i < LEVEL_MAX && l->id != 0xFFFF; i++, l++) {
+            if (l->id == tbl->id) {
+                for (j = 0; j < 4; j++) {
+                    if (l->lv[j] < tbl->lv[j]) {
+                        l->isNew = 1;
+                        l->lv[j] = tbl->lv[j];
+                    }
+                }
+                found = 1;
+                break;
+            }
+        }
+        if (!found) {
+            for (l = d->level.e, i = 0; i < LEVEL_MAX; i++, l++) {
+                if (l->id == 0xFFFF) {
+                    l->id = tbl->id;
+                    for (j = 0; j < 4; j++) {
+                        l->lv[j] = tbl->lv[j];
+                    }
+                    l->isNew = 1;
+                    break;
+                }
+            }
+        }
+    }
+}
