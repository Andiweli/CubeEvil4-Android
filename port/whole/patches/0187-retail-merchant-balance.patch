+// add_stock of the retail discs: the count to add, the endless rocket launcher 0x6D one at most like the rocket
+// launcher 0x35 (the US one only with other texts than Japanese, as the debug build), at most 999.
+static void add_stock_retail(StockEntry* dst, int num)
+{
+    switch (itemType(dst->id)) {
+    case 1:
+    case 9:
+        dst->num = 1;
+        return;
+    case 3:
+        if (dst->id == 0x6D || (dst->id == 0x35 && (merchantEu() || pSys->language != 0))) {
+            dst->num = 1;
+            return;
+        }
+        break;
+    }
+    dst->num += num;
+    if (dst->num > 998) {
+        dst->num = 999;
+    }
+}
