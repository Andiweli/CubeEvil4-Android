# Port patch, two user reports (02.11.2026, OPPO CPH2127, EU discs, with a picture of the retail game): after the
# merchant's exclusive tune-up (Handgun, Punisher, Shotgun, Handcannon, Mine Thrower) the examine text did not
# change, and the Mine Thrower's firepower read "0.0".
# - SsItemExamine::move: the retail releases (EU / US Sscrn.rel) show the exclusive's own text when a level of the
#   weapon is above its table maximum: messages 0x100 Punisher, 0x101 Handgun, 0x102 Shotgun, 0x103 Mine Thrower,
#   0x104 Handcannon, 0x105 Mine Thrower with scope (European table only, the US one has 261 messages). With the
#   debug discs as before (their table ends at 0xFF).
# - getPowerRatio, a bug of the prototype: the Mine Thrower's level 4 (the homing mines) gave 0.0 and the one with
#   scope (0xAB) went through the generic table; the retail releases give both 2/4/6/6 (EU main.dol 0x800189d4).
# Checked on the PC (r100, examine): Handgun 7/3/3/6 shows "No longer your average 9mm handgun..." with EU and US
# discs, "A standard 9mm handgun." with the debug discs; Mine Thrower with scope 4/1/2/3: firepower 6.0, the
# homing-mines text with EU discs.
--- a/src/Sscrn/ss_main.cpp
+++ b/src/Sscrn/ss_main.cpp
@@ -476,12 +476,56 @@
     itemInfo(id, info);
 }
 
+extern "C" int re4_disc_release(void);  /* port: runtime/dvd.cpp (patch 0180) */
+
+/* port (patch 0180, a user's report 02.11.2026): after the exclusive tune-up (a level above the weapon's table
+   maximum) the retail releases' SsItemExamine::move shows the weapon's own text of it, messages 0x100.. of their
+   ss_item.dat (European 262 messages, US 261: without 0x105, the Mine Thrower with scope); the debug build's
+   table ends at 0xFF and it shows the item's text. 0: the item's text. */
+static u16 exclusiveMes(cItem* w)
+{
+    const int release = re4_disc_release();
+    u16 id;
+    int k;
+    int over = 0;
+
+    if (release != 1 && release != 2) {  /* RE4_DISC_RETAIL_EU, RE4_DISC_RETAIL_US */
+        return 0;
+    }
+    id = ItemMgr.weaponId(w);
+    for (k = 0; k < 4; k++) {
+        static const int shift[4] = {12, 8, 4, 0};
+        if (((w->lv >> shift[k]) & 0xF) + 1 > WeaponId2MaxLevel(w->id, k)) {
+            over = 1;
+        }
+    }
+    if (!over) {
+        return 0;
+    }
+    switch (id) {
+    case 0x21:
+        return 0x100;
+    case 0x23:
+        return 0x101;
+    case 0x2C:
+        return 0x102;
+    case 0x36:
+        return 0x103;
+    case 0x37:
+        return 0x104;
+    case 0xAB:
+        return release == 1 ? 0x105 : 0;
+    }
+    return 0;
+}
+
