 void CameraQuasiFPS::offsetCorrection()
 {
     int i;
 
+    qfpsReleaseTables(); /* PORT (patch 0189): the retail discs' tables */
+
     for (i = 0; i < 14; i++) {
         offsetArrayCorrection(g_readyOfs[i]);
     }
