+// The default tables of the inserted discs, before offsetCorrection corrects them.
+static void qfpsReleaseTables()
+{
+    static QFPS_OFFSET dbgReady[14][2][3];
+    static QFPS_OFFSET dbgTrans[TRANS_DATA_AREA][2][3];
+    static int saved;
+    const QfpsRetailRow* rows = qfps_retail_eu;
+    int n = sizeof(qfps_retail_eu) / sizeof(qfps_retail_eu[0]);
+    int i, j, k;
+
+    for (i = 0; i < 14; i++) {
+        for (j = 0; j < 2; j++) {
+            for (k = 0; k < 3; k++) {
+                if (!saved) {
+                    dbgReady[i][j][k] = g_readyOfs[i][j][k];
+                }
+                g_readyOfs[i][j][k] = dbgReady[i][j][k];
+            }
+        }
+    }
+    for (i = 0; i < TRANS_DATA_AREA; i++) {
+        for (j = 0; j < 2; j++) {
+            for (k = 0; k < 3; k++) {
+                if (!saved) {
+                    dbgTrans[i][j][k] = g_transOfs[i][j][k];
+                }
+                g_transOfs[i][j][k] = dbgTrans[i][j][k];
+            }
+        }
+    }
+    saved = 1;
+    if (!re4_disc_retail()) {
+        return;
+    }
+    if (re4_disc_retail_us()) {
+        rows = qfps_retail_us;
+        n = sizeof(qfps_retail_us) / sizeof(qfps_retail_us[0]);
+    }
+    for (i = 0; i < n; i++) {
+        g_readyOfs[rows[i].type][rows[i].side][rows[i].site] = rows[i].o;
+    }
+    // Ada's transition, the middle site's camera (both retail releases)
+    g_transOfs[TRANS_DATA_ADA][0][1].m_campos[0].y = 1700.0f;
+    g_transOfs[TRANS_DATA_ADA][0][1].m_campos[0].z = -1300.0f;
+}
