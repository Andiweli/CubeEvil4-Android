# The difficulty "Berserker" (1.1.2, wish and decisions of the project owner, 24.11.2026; runtime/berserker.cpp):
# Professional (game_mode 6) with a marker in the save's three bytes after game_mode, "More enemies" always on with the
# save's seed and enemies taking 0.8 of the damage (not the animals). Here:
# - title.cpp: once Professional is unlocked, the row BERSERKER above it in the difficulty menu (debug and American
#   discs, the European menu of patch 0139; not the Japanese discs): titleLevelInit adds it (the cursor's row 0, the
#   cursor stays on Normal), titleLevelSelect takes row 0 as Berserker and counts the others one further down;
# - game.cpp: gameInit gives a new game the marker when Berserker was chosen (else none; a loaded game keeps its
#   save's), clearGlobalSaveData (a new round) keeps it like game_mode;
# - em_sub.cpp: LifeDownSet2 takes 0.8 of an enemy's damage after the game's own rank factor;
# - card.cpp: dispSaveInfo shows BSK in the save list's Mode column for a Berserker save (header byte 0x3F, GLOBAL_WK
#   pad_4F8B, set by gameInit; an older version shows Professional);
# - id_tex.cpp / id_sys.cpp: the pictures' textures (no TPL of the game) for IdTexSet, no texture animation for them.
# Not a bug of the prototype: a port feature. Without Berserker chosen nothing changes.
diff --git a/src/game/card.cpp b/src/game/card.cpp
index 2d50fb7..fd6c707 100644
--- a/src/game/card.cpp
+++ b/src/game/card.cpp
@@ -3180,6 +3180,8 @@ void CardDbgCacheSet()
         }                                                 \
     }
 
+extern "C" void re4_berserker_list_mark(IDSystem* id, int type, int mode, int mark, int broken); /* port (patch 0255) */
+
 // Fills save slot `no`'s list entry ids: chapter / difficulty / play time / save count digits
 // from the header (or the "broken" / "no data" variants).
 void dispSaveInfo(int no, SaveInfo* p_info, int type, int flag)
@@ -3342,6 +3344,8 @@ skip:
             break;
         }
     }
+    /* port (patch 0255): a Berserker save shows BSK in the Mode column (runtime/berserker.cpp) */
+    re4_berserker_list_mark(id, type, p_info->game_mode_disp, p_info->pad_3F, flag);
 }
 
 // Refreshes every list entry from the card's file flags / headers.
diff --git a/src/game/em_sub.cpp b/src/game/em_sub.cpp
