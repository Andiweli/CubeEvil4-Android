+extern "C" int re4_berserker_damage(int id, int dm_val, int hp, const void* em); /* port (patch 0255): runtime/berserker.cpp */
+
 // LifeDownSet2 without the random spread: take `dmg` life from `em`, flag bit0 keeps 1 point.
 int LifeDownSet(cEm* pEm, int dm_val, int rnd)
 {
@@ -1989,6 +1991,7 @@ int LifeDownSet2(cEm* pEm, int dm_val, int rnd, int flag)
                 rate = 2.0f - (f32) pG->Game_level * 0.2f;
             }
             dm_val = (int) ((f32) dm_val * rate);
+            dm_val = re4_berserker_damage(pEm->id, dm_val, pEm->hp, pEm); /* port (patch 0255): Berserker, 0.8 */
             if (pEm->id >= 0x10 && pEm->id <= 0x3F && dm_val > 100) {
                 GameAddPoint(LVADD_EM_DAMAGE);
             }
