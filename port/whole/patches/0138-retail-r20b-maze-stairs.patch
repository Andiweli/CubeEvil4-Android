+            SmdSetTrans(0x88, 0);
+            SmdSetTrans(0x89, 0);
+            SmdSetTrans(0x8A, 0);
+            SceAtSetEnable(0x80, 0);
+            SceAtSetEnable(0x81, 0);
+            SceAtSetEnable(0x82, 0);
+            SceAtSetEnable(0x88, 0);
+            if (getRoomEtcBox(9, &box, 1)) {
+                EmMgr.destroy((cEm*) box);
+            }
+            if (getRoomEtcBox(0xA, &box, 1)) {
+                EmMgr.destroy((cEm*) box);
+            }
+            if (getRoomEtcBox(0xE, &box, 1)) {
+                EmMgr.destroy((cEm*) box);
+            }
+            if (getRoomEtcBox(0xF, &box, 1)) {
+                EmMgr.destroy((cEm*) box);
+            }
+        }
+    }
     EvtMgr.SetFunc("evt_r20bs00_func", (void*) Evt_R20BS00_Func);
     EvtMgr.SetFunc("evt_r20bs99_func", (void*) Evt_R20BS00_Func);
     pG->Room_flg[0] &= 0x7FFFFFFF;
