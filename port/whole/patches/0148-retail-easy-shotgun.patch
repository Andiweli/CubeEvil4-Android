 // the church bell event (s30), the house event (s20), the binocular view (s00) and the door messages.
@@ -255,6 +256,11 @@
             m->LightInfo.EnableMask = (m->LightInfo.EnableMask & ~0x20) | 8;
         }
     }
+    /* PORT (patch 0148): on Easy the European / Japanese R101Init (st1_1.rel 0x9a4) switches the shotgun's
+       item area 0x8A off: that game starts with the shotgun (cItemMgr::set_game) */
+    if ((re4_disc_retail_eu() || re4_disc_retail_jp()) && pG->game_mode <= 3) {
+        SceAtSetEnable(0x8A, 0);
+    }
 }
 
