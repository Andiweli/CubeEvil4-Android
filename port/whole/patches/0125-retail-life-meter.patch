# Retail data (port/docs/retail-eu-plan.md): the life meter's name plates with the European discs. Its
# layout (etc/core.das CORE_LIFE_METER_ID) has six name plates, units 0x40..0x45, in both releases; this
# build hides 0x40..0x42 and shows the one of the player type (Leon, Ada, the third), the European
# LifeMeter::roomInit (main.dol 0x800c05a8) hides all six and shows 0x45 for player type 3, 0x43 for 4,
# 0x44 for 5 as well. On the debug build's discs the three plates are empty, on the European ones they
# carry names and lay over Leon's ("KiLeonr" on the Retroid, 26.10.2026). With the European discs the
# three are handled as there. Nothing changes with the debug build's discs. A port patch for retail data.
# Also the Japanese discs (port/docs/retail-jp-plan.md, J4: their code is the European one here):
# re4_disc_retail(), the switch of every retail release.
# US release (port/docs/retail-us-plan.md): its LifeMeter::roomInit is the European one (main.dol
# 0x800bf4b8, every instruction alike): both retail releases (re4_disc_retail).
--- a/src/game/cockpit.cpp
+++ b/src/game/cockpit.cpp
@@ -106,6 +106,8 @@
 // Creates the life meter ids (player, and the partner's when Ashley is present), reads the
 // colour templates (units 0x0F..0x11: fine / caution / danger) and starts the smoothed values at
 // the current life.
+extern "C" int re4_disc_retail(void), re4_disc_retail_eu(void), re4_disc_retail_jp(void); /* port: runtime/dvd.cpp */
+
 void LifeMeter::roomInit()
 {
     ID_UNIT* u;
@@ -124,6 +126,25 @@
     case 2:
         IdSys.unitPtr(0x42, IDC_LIFE_METER)->be_flag |= 8;
         break;
+    }
+    /* port: the European life meter has three more name plates the European LifeMeter::roomInit
+       (main.dol 0x800c05a8) hides as well: 0x43 for player type 4, 0x44 for 5, 0x45 for 3; shown,
+       they lay over Leon's ("KiLeonr", device test 26.10.2026) */
+    if (re4_disc_retail()) {
+        IdSys.unitPtr(0x43, IDC_LIFE_METER)->be_flag &= ~8;
+        IdSys.unitPtr(0x44, IDC_LIFE_METER)->be_flag &= ~8;
+        IdSys.unitPtr(0x45, IDC_LIFE_METER)->be_flag &= ~8;
+        switch (pG->pl_type) {
+        case 3:
+            IdSys.unitPtr(0x45, IDC_LIFE_METER)->be_flag |= 8;
+            break;
+        case 4:
+            IdSys.unitPtr(0x43, IDC_LIFE_METER)->be_flag |= 8;
+            break;
+        case 5:
+            IdSys.unitPtr(0x44, IDC_LIFE_METER)->be_flag |= 8;
+            break;
+        }
     }
     disp(1);
     m_life = (f32) (s16) pG->pl_life;
