# glslang (Khronos): GLSL to SPIR-V at run time for the Vulkan renderer (port/docs/vulkan-bauplan.md, E0).
# Built from the copy the Android NDK ships (sources/third_party/shaderc/third_party/glslang, 11.11.0 in r28c), so
# no foreign sources live in the repository. GLSL only: no HLSL front end, no SPIR-V optimizer (SpvTools.cpp compiles
# to nothing without ENABLE_OPT). Licences: BSD-3-Clause, BSD-2-Clause, Khronos MIT-like, Apache-2.0 (SPIRV/bitutils.h,
# SPIRV/hex_float.h), GPL-3.0 with the Bison exception (the generated glslang_tab.cpp); the texts:
# port/android-decomp/app/src/main/cpp/third_party/glslang/LICENSE.txt
#
# Result: RE4_HAVE_GLSLANG and the static library re4_glslang (PUBLIC include directories: <glslang/Public/...>,
# <SPIRV/GlslangToSpv.h>).
set(RE4_GLSLANG_DIR "" CACHE PATH "glslang sources (default: the Android NDK's copy)")
set(RE4_HAVE_GLSLANG OFF)
if(NOT RE4_GLSLANG_DIR)
    set(_re4_ndks "")
    foreach(_re4_v ANDROID_NDK CMAKE_ANDROID_NDK)
        if(${_re4_v})
            list(APPEND _re4_ndks "${${_re4_v}}")
        endif()
    endforeach()
    foreach(_re4_e ANDROID_NDK_HOME ANDROID_NDK_ROOT)
        if(DEFINED ENV{${_re4_e}})
            list(APPEND _re4_ndks "$ENV{${_re4_e}}")
        endif()
    endforeach()
    # whole_build_android.sh's default (sudo port/tools/whole_setup_linux.sh --android installs it there)
    list(APPEND _re4_ndks "/opt/android-ndk-r28c")
    foreach(_re4_ndk IN LISTS _re4_ndks)
        if(EXISTS "${_re4_ndk}/sources/third_party/shaderc/third_party/glslang/glslang/Public/ShaderLang.h")
            set(RE4_GLSLANG_DIR "${_re4_ndk}/sources/third_party/shaderc/third_party/glslang")
            break()
        endif()
    endforeach()
endif()
if(RE4_GLSLANG_DIR AND EXISTS "${RE4_GLSLANG_DIR}/glslang/Public/ShaderLang.h")
    set(RE4_HAVE_GLSLANG ON)
    set(_g "${RE4_GLSLANG_DIR}")
    # glslang/build_info.h (upstream: build_info.py from CHANGES.md): the version of the first "## X.Y.Z" heading
    file(STRINGS "${_g}/CHANGES.md" _re4_glslang_heading REGEX "^## [0-9]+\\.[0-9]+\\.[0-9]+" LIMIT_COUNT 1)
    string(REGEX MATCH "([0-9]+)\\.([0-9]+)\\.([0-9]+)" _re4_glslang_version "${_re4_glslang_heading}")
    set(RE4_GLSLANG_VERSION "${_re4_glslang_version}")
    set(_re4_glslang_gen "${CMAKE_CURRENT_BINARY_DIR}/glslang-generated")
    file(WRITE "${_re4_glslang_gen}/glslang/build_info.h.new"
        "// generated by port/android-decomp/app/src/main/cpp/cmake/glslang.cmake\n"
        "#ifndef GLSLANG_BUILD_INFO\n#define GLSLANG_BUILD_INFO\n"
        "#define GLSLANG_VERSION_MAJOR ${CMAKE_MATCH_1}\n#define GLSLANG_VERSION_MINOR ${CMAKE_MATCH_2}\n"
        "#define GLSLANG_VERSION_PATCH ${CMAKE_MATCH_3}\n#define GLSLANG_VERSION_FLAVOR \"\"\n"
        "#define GLSLANG_VERSION_GREATER_THAN(major, minor, patch) ((GLSLANG_VERSION_MAJOR) > (major) || ((major) == GLSLANG_VERSION_MAJOR && ((GLSLANG_VERSION_MINOR) > (minor) || ((minor) == GLSLANG_VERSION_MINOR && (GLSLANG_VERSION_PATCH) > (patch)))))\n"
        "#define GLSLANG_VERSION_GREATER_OR_EQUAL_TO(major, minor, patch) ((GLSLANG_VERSION_MAJOR) > (major) || ((major) == GLSLANG_VERSION_MAJOR && ((GLSLANG_VERSION_MINOR) > (minor) || ((minor) == GLSLANG_VERSION_MINOR && (GLSLANG_VERSION_PATCH >= (patch))))))\n"
        "#define GLSLANG_VERSION_LESS_THAN(major, minor, patch) ((GLSLANG_VERSION_MAJOR) < (major) || ((major) == GLSLANG_VERSION_MAJOR && ((GLSLANG_VERSION_MINOR) < (minor) || ((minor) == GLSLANG_VERSION_MINOR && (GLSLANG_VERSION_PATCH) < (patch)))))\n"
        "#define GLSLANG_VERSION_LESS_OR_EQUAL_TO(major, minor, patch) ((GLSLANG_VERSION_MAJOR) < (major) || ((major) == GLSLANG_VERSION_MAJOR && ((GLSLANG_VERSION_MINOR) < (minor) || ((minor) == GLSLANG_VERSION_MINOR && (GLSLANG_VERSION_PATCH <= (patch))))))\n"
        "#endif\n")
    configure_file("${_re4_glslang_gen}/glslang/build_info.h.new" "${_re4_glslang_gen}/glslang/build_info.h" COPYONLY)
    set(_mi "${_g}/glslang/MachineIndependent")
    add_library(re4_glslang STATIC
        "${_g}/glslang/OSDependent/Unix/ossource.cpp"
        "${_g}/OGLCompilersDLL/InitializeDll.cpp"
        "${_g}/glslang/GenericCodeGen/CodeGen.cpp"
        "${_g}/glslang/GenericCodeGen/Link.cpp"
        "${_mi}/attribute.cpp" "${_mi}/Constant.cpp" "${_mi}/glslang_tab.cpp" "${_mi}/InfoSink.cpp"
        "${_mi}/Initialize.cpp" "${_mi}/Intermediate.cpp" "${_mi}/intermOut.cpp" "${_mi}/IntermTraverse.cpp"
        "${_mi}/iomapper.cpp" "${_mi}/limits.cpp" "${_mi}/linkValidate.cpp" "${_mi}/parseConst.cpp"
        "${_mi}/ParseContextBase.cpp" "${_mi}/ParseHelper.cpp" "${_mi}/PoolAlloc.cpp"
        "${_mi}/propagateNoContraction.cpp" "${_mi}/reflection.cpp" "${_mi}/RemoveTree.cpp" "${_mi}/Scan.cpp"
        "${_mi}/ShaderLang.cpp" "${_mi}/SpirvIntrinsics.cpp" "${_mi}/SymbolTable.cpp" "${_mi}/Versions.cpp"
        "${_mi}/preprocessor/PpAtom.cpp" "${_mi}/preprocessor/PpContext.cpp" "${_mi}/preprocessor/Pp.cpp"
        "${_mi}/preprocessor/PpScanner.cpp" "${_mi}/preprocessor/PpTokens.cpp"
        "${_g}/SPIRV/GlslangToSpv.cpp" "${_g}/SPIRV/InReadableOrder.cpp" "${_g}/SPIRV/Logger.cpp"
        "${_g}/SPIRV/SpvBuilder.cpp" "${_g}/SPIRV/SpvPostProcess.cpp" "${_g}/SPIRV/SpvTools.cpp"
        "${_g}/SPIRV/disassemble.cpp" "${_g}/SPIRV/doc.cpp")
    target_include_directories(re4_glslang SYSTEM PUBLIC "${_g}" "${_re4_glslang_gen}"
        PRIVATE "${_mi}" "${_g}/glslang/OSDependent/Unix")
    target_compile_definitions(re4_glslang PRIVATE GLSLANG_OSINCLUDE_UNIX)
    # foreign code: its own warnings stay quiet; optimised in every build (the compile time of a shader on the device)
    target_compile_options(re4_glslang PRIVATE -w -O2 -fno-rtti -fno-exceptions)
    set_target_properties(re4_glslang PROPERTIES POSITION_INDEPENDENT_CODE ON)
    find_package(Threads)
    if(Threads_FOUND)
        target_link_libraries(re4_glslang PUBLIC Threads::Threads)
    endif()
    message(STATUS "glslang ${RE4_GLSLANG_VERSION}: ${RE4_GLSLANG_DIR}")
else()
    message(STATUS "glslang: not found (the Vulkan renderer is left out; RE4_GLSLANG_DIR or an Android NDK)")
endif()
