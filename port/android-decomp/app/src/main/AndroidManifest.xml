<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- Android Automotive (wish of the project owner, 04.11.2026, as in his UT99 and UE1 ports): one APK for
         phones, the Retroid, TV and cars. A landscape lock is no requirement (car screens can stand upright,
         the game is then letterboxed), and no automotive requirement either: the same APK still installs
         everywhere -->
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <!-- the core mode passes the game's rumble to the device's vibrator -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- the in-game menu's update button (AppUpdate): GitHub's newest release, its APK to Android's installer -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- largeHeap: on 64 bit the core takes MEM1 from ART's large object space
         (core_mode.cpp holdMem1InLargeObjectSpace), for a moment with up to
         about 250 MB of arrays that count as Java memory -->
    <application android:largeHeap="true" android:name=".Re4Application" android:label="@string/app_label" android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false"
        android:isGame="true" android:appCategory="game" android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true">
        <!-- the car's launcher lists the app (as the owner's FileExplorerAAOS) -->
        <meta-data android:name="androidx.car.app.launchable" android:value="true" />
        <activity android:name=".StartupActivity" android:exported="false" android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".RoomCheckActivity" android:exported="false" />
        <!-- locale|layoutDirection: a new language (the phone's or the app's own) keeps the running
             game; the menu takes it the next time it opens -->
        <!-- uiMode: a car switches day / night with its lights (and phones with their dark-mode schedule),
             screenLayout|smallestScreenSize|density: a car's split screen or a second display; the running game
             stays instead of a new start of the window. distractionOptimized false: a game, Android Automotive
             covers it while the car drives (the game pauses as on the home screen, onPause) -->
        <activity android:name=".CoreActivity" android:exported="false" android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|locale|layoutDirection|uiMode|screenLayout|smallestScreenSize|density">
            <meta-data android:name="distractionOptimized" android:value="false" />
        </activity>
        <activity android:name=".ControllerActivity" android:exported="false" android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- the way back to the start screen from a running game (Management: "Import other discs"): ends the game's
             process from a process of its own and opens the launcher in a new one (the core cannot restart inside
             its process); its own task, so the game's task can go first -->
        <activity android:name=".LauncherRestartActivity" android:exported="false" android:process=":restart"
            android:taskAffinity="${applicationId}.restart" android:excludeFromRecents="true" android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- the core mode's error report for the app it is sent with (CoreLog, M11) -->
        <provider android:name=".ReportProvider" android:authorities="${applicationId}.report"
            android:exported="false" android:grantUriPermissions="true" />
        <!-- uiMode / keyboard / navigation: the car's day / night switch or a controller connected while discs are
             imported keeps the screen -->
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="uiMode|keyboard|keyboardHidden|navigation">
            <meta-data android:name="distractionOptimized" android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
