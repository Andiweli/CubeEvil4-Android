<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- no force dark: Android's dark mode for apps (MIUI turns it on for apps by itself) recolours light colours
         of what the windows draw; the app is dark already (FocusLook, 0.99.11) -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
