<?xml version="1.0" encoding="utf-8"?>
<!-- CubeEvil4 Texture Packer (port/docs/textur-packer-android-plan.md): one screen, the conversion as a foreground
     service. No internet, no storage permission: the pack is read through Android's file picker, the file written
     into the Download folder through MediaStore (Android 10 and later) or Android's save dialog (7 to 9). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application android:label="@string/app_name" android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher" android:theme="@style/AppTheme" android:allowBackup="false"
        android:supportsRtl="true" android:localeConfig="@xml/locales_config">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".ConvertService" android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
